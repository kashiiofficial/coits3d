{
  "name": "coits3d",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "scripts": {
    "test": "node --import tsx --test test/*.test.ts",
    "build:demo": "esbuild demo/main.ts --bundle --format=esm --external:node:* --outfile=demo/bundle.js",
    "build:tiles": "tsx builder/build.ts --in builder/sample.osm.pbf --out demo/tiles --minz 14 --maxz 16",
    "typecheck": "tsc --noEmit",
    "demo": "npm run build:tiles && npm run build:demo && python3 -m http.server 8765 --bind 127.0.0.1"
  },
  "devDependencies": {
    "@types/earcut": "^3.0.0",
    "@types/node": "^26.6.5",
    "earcut": "^3.2.4",
    "esbuild": "^0.28.2",
    "playwright-core": "^1.64.1",
    "tsx": "^4.23.15",
    "typescript": "^7.0.2"
  },
  "license": "MIT",
  "description": "CoitsMoves 3D map: tile core, loader, LOD selection and WebGL2 renderer",
  "engines": {
    "node": ">=20"
  }
}
